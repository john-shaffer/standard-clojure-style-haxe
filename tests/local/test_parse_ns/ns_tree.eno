# ns metadata: stacked shorthand keys are all collected

--Input
(ns ^:a ^:b foo)
--Input

--Expected
{
  "nsSymbol": "foo",
  "nsMetadata": [
    {"key": ":a", "value": "true"},
    {"key": ":b", "value": "true"}
  ]
}
--Expected

# ns metadata: shorthand and map before the symbol are both collected

--Input
(ns ^:a ^{:b 1} foo)
--Input

--Expected
{
  "nsSymbol": "foo",
  "nsMetadata": [
    {"key": ":a", "value": "true"},
    {"key": ":b", "value": "1"}
  ]
}
--Expected

# ns metadata: the #^ marker works like ^

--Input
(ns #^:a foo)
--Input

--Expected
{
  "nsSymbol": "foo",
  "nsMetadata": [
    {"key": ":a", "value": "true"}
  ]
}
--Expected

# a discard between ns and the ns symbol is not the symbol

--Input
(ns #_disc
  foo)
--Input

--Expected
{
  "nsSymbol": "foo"
}
--Expected

# ns metadata map: a discard is not a key or a value

--Input
(ns foo
  {:a 1 #_{:x 1} :c 3})
--Input

--Expected
{
  "nsSymbol": "foo",
  "nsMetadata": [
    {"key": ":a", "value": "1"},
    {"key": ":c", "value": "3"}
  ]
}
--Expected

# a discard after the symbol of a libspec is a comment after the libspec

--Input
(ns foo
  (:require
   [a.b #_x :refer [d c]]
   [e.f]))
--Input

--Expected
{
  "nsSymbol": "foo",
  "requires": [
    {
      "symbol": "a.b",
      "commentAfter": "#_x",
      "refer": [
        {"symbol": "c"},
        {"symbol": "d"}
      ]
    },
    {
      "symbol": "e.f"
    }
  ]
}
--Expected

# the comment on the keyword line of a second :import is the comment after :import

--Input
(ns foo
  (:import
   (java.util Date))
  (:import ;; second
   (java.io File)))
--Input

--Expected
{
  "nsSymbol": "foo",
  "importCommentAfter": ";; second",
  "imports": [
    {
      "package": "java.io",
      "classes": ["File"]
    },
    {
      "package": "java.util",
      "classes": ["Date"]
    }
  ]
}
--Expected

# a comment after the ns on a later line does not attach to the ns

--Input
(ns foo
  (:refer-clojure :exclude [get assoc]))

(def x 1) ;; not part of the ns
--Input

--Expected
{
  "nsSymbol": "foo",
  "referClojure": {
    "exclude": [
      {"symbol": "assoc"},
      {"symbol": "get"}
    ]
  }
}
--Expected

# a discard between metadata and a libspec travels with the libspec

--Input
(ns foo
  (:require
   ^:no-doc #_disc
   [zzz.core :as z]
   [aaa.core]))
--Input

--Expected
{
  "nsSymbol": "foo",
  "requires": [
    {
      "symbol": "aaa.core"
    },
    {
      "symbol": "zzz.core",
      "as": "z",
      "commentsAbove": ["#_disc"],
      "metadata": ["^:no-doc"]
    }
  ]
}
--Expected

# a prefix list inside a reader conditional gives its requires the platform

--Input
(ns foo
  (:require
   #?(:clj [clojure [string :as str] set])
   [other.lib]))
--Input

--Expected
{
  "nsSymbol": "foo",
  "requires": [
    {
      "symbol": "clojure.set",
      "platform": ":clj"
    },
    {
      "symbol": "clojure.string",
      "as": "str",
      "platform": ":clj"
    },
    {
      "symbol": "other.lib"
    }
  ]
}
--Expected

# require-macros :refer :all is refer all, as in :require

--Input
(ns foo
  (:require-macros
   [a.macros :refer :all :as m]))
--Input

--Expected
{
  "nsSymbol": "foo",
  "requireMacros": [
    {
      "symbol": "a.macros",
      "as": "m",
      "refer": "all"
    }
  ]
}
--Expected

# an own-line discard and the comment after it travel together in :import

--Input
(ns foo
  (:import
   (java.util UUID)
   #_x ;; about Date
   (java.util Date)))
--Input

--Expected
{
  "nsSymbol": "foo",
  "imports": [
    {
      "package": "java.util",
      "classes": ["Date", "UUID"],
      "commentsAbove": ["#_x ;; about Date"]
    }
  ]
}
--Expected

# comment after a later form on the ns close line is not part of the ns

--Input
(ns a (:require [b])) (def x) ;; c
--Input

--Expected
{
  "nsSymbol": "a",
  "requires": [
    {
      "symbol": "b"
    }
  ]
}
--Expected

# require :as must be followed by a symbol

--Input
(ns a (:require [b :as :refer c]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :as must be followed by a symbol."
}
--Expected

# require :as at the end of a libspec is an error

--Input
(ns a (:require [b :as]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :as must be followed by a symbol."
}
--Expected

# require :include-macros must be followed by a boolean

--Input
(ns a (:require [b :include-macros yes]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :include-macros must be followed by true or false."
}
--Expected

# comment after a multi-line libspec belongs to the libspec

--Input
(ns a
  (:require [b
             :as c] ;; x
            [d]))
--Input

--Expected
{
  "nsSymbol": "a",
  "requires": [
    {
      "symbol": "b",
      "as": "c",
      "commentAfter": ";; x"
    },
    {
      "symbol": "d"
    }
  ]
}
--Expected

# require unknown option is an error

--Input
(ns a (:require [b :foo bar]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :foo is not a supported option."
}
--Expected

# require option that is not a keyword is an error

--Input
(ns a (:require [b :as c "d"]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require options must be keywords."
}
--Expected

# require :refer must be followed by :all or a collection

--Input
(ns a (:require [b :refer c]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :refer must be followed by :all or a collection."
}
--Expected

# require :rename must be followed by a collection

--Input
(ns a (:require [b :rename c]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :rename must be followed by a collection."
}
--Expected

# require :rename needs pairs of symbols

--Input
(ns a (:require [b :rename {c d, e}]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require :rename must be followed by pairs of symbols."
}
--Expected

# require-macros unknown option is an error

--Input
(ns a (:require-macros [b :foo bar]))
--Input

--Expected
{
  "parsingShouldError": true,
  "errorMessage": ":require-macros :foo is not a supported option."
}
--Expected
