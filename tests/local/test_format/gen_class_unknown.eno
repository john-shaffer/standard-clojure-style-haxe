# gen-class unknown keys are printed by shape after the known keys

--Input
(ns foo
  (:gen-class :foo [x
                    y] :name foo.Bar :bar baz :main [a] :baz {a b}))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   :foo [x y]
   :bar baz
   :main [a]
   :baz {a b}))
--Expected

# gen-class unknown keys keep their comments

--Input
(ns foo
  (:gen-class
   :name foo.Bar
   ;; about foo
   :foo [x y] ;; after foo
   :bar baz))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   ;; about foo
   :foo [x y] ;; after foo
   :bar baz))
--Expected

# gen-class unknown values keep reader conditionals

--Input
(ns foo
  (:gen-class :name foo.Bar :foo #?(:clj [x y] :cljs [z]) :bar #?@(:clj [a b])))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   :foo #?(:clj [x y] :cljs [z])
   :bar #?@(:clj [a b])))
--Expected

# gen-class unknown values keep commas

--Input
(ns foo
  (:gen-class :name foo.Bar :foo {a b, c d} :bar [x, y]))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   :foo {a b, c d}
   :bar [x, y]))
--Expected

# gen-class unknown values keep comments inside them

--Input
(ns foo
  (:gen-class :name foo.Bar :foo [x ;; the x
                                  y]))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   :foo [x ;; the x
         y]))
--Expected

# gen-class unknown values do not comment out their closing bracket

--Input
(ns foo
  (:gen-class :name foo.Bar :foo [x ;; the x
                                  ]))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   :foo [x ;; the x
         ]))
--Expected

# a repeated known key with a value of the wrong kind keeps the earlier valid value

--Input
(ns foo
  (:gen-class :name foo.Bar :name [a b]))
--Input

--Expected
(ns foo
  (:gen-class
   :name foo.Bar
   :name [a b]))
--Expected
