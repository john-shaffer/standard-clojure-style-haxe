# a comment on a later form is not moved into the ns

--Input
(ns foo
  (:refer-clojure :exclude [get assoc]))

(def x 1) ;; not part of the ns
--Input

--Expected
(ns foo
  (:refer-clojure :exclude [assoc get]))

(def x 1) ;; not part of the ns
--Expected

# a comment after the ns on a later line than refer-clojure stays after the ns

--Input
(ns foo
  (:refer-clojure :exclude [get assoc])
  ) ;; after ns
--Input

--Expected
(ns foo
  (:refer-clojure :exclude [assoc get])) ;; after ns
--Expected

# a discard between metadata and a libspec is kept above the libspec

--Input
(ns foo
  (:require
   ^:no-doc #_disc
   [zzz.core :as z]
   [aaa.core]))
--Input

--Expected
(ns foo
  (:require
   [aaa.core]
   #_disc
   ^:no-doc
   [zzz.core :as z]))
--Expected

# require-macros :refer :all is printed

--Input
(ns foo
  (:require-macros [a.macros :refer :all]))
--Input

--Expected
(ns foo
  (:require-macros
   [a.macros :refer :all]))
--Expected

# comment after a form on the same line as the ns close stays with that form

--Input
(ns a (:require [b])) (def x) ;; c
--Input

--Expected
(ns a
  (:require
   [b])) (def x) ;; c
--Expected

# trailing comments after multi-line prefix list entries and import package lists stay with them

--Input
(ns a
  (:require [b
             [c
              :as d] ;; x
             [e]])
  (:import (f G
              H) ;; y
           (i J)))
--Input

--Expected
(ns a
  (:require
   [b.c :as d] ;; x
   [b.e])
  (:import
   (f G H) ;; y
   (i J)))
--Expected
